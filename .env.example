# Copy to .env at the repository root. Every value here is a placeholder.
# Local mode needs no .env at all: with nothing set the app runs as MODE=local on embedded Postgres.
# MODE, DATABASE_URL, DATA_DIR, APP_URL, AUTH_SECRET, OWNER_USER_ID and APP_SECRET are read; STORAGE is reserved.

# local: one person, no account, embedded Postgres (PGlite). hosted: many users, a Postgres server.
MODE=local

# Hosted mode only: PostgreSQL connection string. Ignored in local mode.
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# Local mode only: where the embedded database and local files live. Default ./.data (gitignored).
# DATA_DIR=./.data

# Public origin of the app. Sets cookie security (Secure when https) and the trusted origin for sign-in.
# APP_URL=http://localhost:3100

# Hosted mode only: secret for signing sessions (at least 32 characters).
# Generate long random values, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET=<generate-a-long-random-value>

# Master secret for encrypting the AI provider keys people save in Settings > AI (AES-256-GCM), at least 32 characters.
# Required in hosted mode before a key can be saved. Local mode uses it when set; otherwise it creates a key file
# (secret.key) in DATA_DIR with owner-only permissions. Changing it makes saved keys unreadable: enter them again.
# APP_SECRET=<generate-a-long-random-value>

# Hosted mode only: the user id of the designated owner. Only this user may receive the private owner seed
# (pnpm seed:owner). Create the account first, then copy its id from Settings > Profile.
# OWNER_USER_ID=<uuid-of-the-owner-account>

# Where article assets are kept. local = a folder under DATA_DIR. s3 arrives with hosted mode.
# STORAGE=local

# AI needs no environment variables: providers (a local Ollama model, an OpenAI-compatible service, your own
# Anthropic API key, or Claude Code hand-off) are added per user in Settings > AI. The app works with none.

# Test only: lets the DEV.to and Hashnode adapters talk to a fake server on this machine instead of the real
# platform. Both the flag and a loopback address are required; anything else is ignored. Never set these for real use.
# CPH_ALLOW_TEST_PLATFORM_URLS=1
# CPH_TEST_DEVTO_URL=http://127.0.0.1:4731
# CPH_TEST_HASHNODE_URL=http://127.0.0.1:4732
