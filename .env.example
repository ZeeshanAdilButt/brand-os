# Copy to .env at the repository root. Every value here is a placeholder.
# Local mode needs no .env at all: with nothing set the app runs as MODE=local on embedded Postgres.
# MODE, DATABASE_URL, DATA_DIR, APP_URL, AUTH_SECRET and OWNER_USER_ID are read as of Day 2; the others are reserved for the day noted.

# local: one person, no account, embedded Postgres (PGlite). hosted: many users, a Postgres server.
MODE=local

# Hosted mode only: PostgreSQL connection string. Ignored in local mode.
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# Local mode only: where the embedded database and local files live. Default ./.data (gitignored).
# DATA_DIR=./.data

# Public origin of the app. Sets cookie security (Secure when https) and the trusted origin for sign-in.
# APP_URL=http://localhost:3100

# Hosted mode only: secret for signing sessions (at least 32 characters) and, from Day 4, for encrypting stored
# provider keys. Generate long random values, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET=<generate-a-long-random-value>

# Hosted mode only: the user id of the designated owner. Only this user may receive the private owner seed
# (pnpm seed:owner). Create the account first, then copy its id from Settings > Profile.
# OWNER_USER_ID=<uuid-of-the-owner-account>
# ENCRYPTION_KEY=<generate-a-long-random-value>

# Where article assets are kept. local = a folder under DATA_DIR. s3 arrives with hosted mode.
# STORAGE=local

# Optional AI (Day 4). The app works with all of these unset.
# Local model through Ollama or any OpenAI-compatible server:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Your own Anthropic API key (a Claude login is never accepted):
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
